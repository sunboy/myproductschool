NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local/CI e2e only. Leave unset in production so rate limiting fails closed without Upstash.
RATE_LIMIT_MEMORY_FALLBACK=
# Local/CI e2e only. Leave unset in production so discussion moderation fails closed without OpenAI.
DISCUSSION_MODERATION_E2E_FALLBACK=
# Local/CI e2e only. Leave unset in production so bot checks fail closed without Turnstile.
TURNSTILE_E2E_FALLBACK=
OPENAI_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=
ADMIN_SECRET=
UNSUBSCRIBE_TOKEN_SECRET=
REAUTH_TOKEN_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE_THINK_BASE_URL=
# Judge0 code runner (Python/JS/Java/C++/Go) via RapidAPI. Without it, Run/Submit
# return a 503 "code runner not configured". Set in .env.local AND in every Vercel
# environment (Production included). SQL runs client-side and does not need this.
JUDGE0_RAPIDAPI_KEY=
LIVE_INTERVIEW_VOICE_TOKEN_SECRET=
# Build-time launch flag. Keep false/unset until Stripe Connect and affiliate env are configured.
NEXT_PUBLIC_ENABLE_AFFILIATES=
AFFILIATE_HASH_SECRET=
STRIPE_AFFILIATE_COUPON_ID=
STRIPE_TEST_AFFILIATE_COUPON_ID=
NEXT_PUBLIC_IDLE_TIMEOUT_MIN=30
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_TRACES_SAMPLE_RATE=0

# Set to true on main/production to mask all API error messages from responses
MASK_API_ERRORS=false

# ─── Claude Code Analytics sandbox (GCP Cloud Run) ───────────────────────────
# Provider selection. 'cloud_run' is the only supported value today; 'gke' and
# 'e2b' are reserved for future HostProvider implementations.
SANDBOX_PROVIDER=cloud_run
# GCP project that hosts the Cloud Run service (e.g. hackproduct).
GCP_PROJECT=
# GCP region the service is deployed in (e.g. us-central1).
CLOUD_RUN_REGION=
# Name of the pre-deployed Cloud Run service running the sandbox image.
CLOUD_RUN_SERVICE=
# Public hostname (without scheme) the browser connects to for WSS (e.g. sandbox.hackproduct.dev).
SANDBOX_WSS_HOST=
# Service-account JSON (base64 or raw) that has Cloud Run Admin API permissions.
# Used by the orchestrator to provision/destroy per-session revisions. Never commit values.
CLOUD_RUN_SA_JSON=
# HMAC secret shared between the orchestrator and every sandbox container.
# Used to sign WSS connection tokens (session-token.ts) and snapshot bearer tokens.
SESSION_TOKEN_SECRET=
# Read-only BigQuery service-account JSON injected into each sandbox container as
# GOOGLE_APPLICATION_CREDENTIALS_JSON. Grants SELECT on challenge datasets only.
CC_BIGQUERY_SA_JSON=
# Maximum session lifetime in seconds (default 1800 = 30 min). Cloud Run drops
# WebSocket connections at 60 min regardless; sessions must be <= 3600.
CC_SESSION_TTL_SECONDS=1800
